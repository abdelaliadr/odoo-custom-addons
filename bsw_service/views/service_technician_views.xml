<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_service_technician_list" model="ir.ui.view">
            <field name="name">service.technician.list</field>
            <field name="model">service.technician</field>
            <field name="arch" type="xml">
                <list string="Techniciens">
                    <field name="name"/>
                    <field name="team_id"/>
                    <field name="phone"/>
                    <field name="intervention_count"/>
                </list>
            </field>
        </record>

        <record id="view_service_technician_form" model="ir.ui.view">
            <field name="name">service.technician.form</field>
            <field name="model">service.technician</field>
            <field name="arch" type="xml">
                <form string="Technicien">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="team_id"/>
                            <field name="user_id"/>
                            <field name="phone"/>
                            <field name="active"/>
                        </group>
                        <notebook>
                            <page string="Interventions">
                                <field name="intervention_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="date_planned"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_service_technician" model="ir.actions.act_window">
            <field name="name">Techniciens</field>
            <field name="res_model">service.technician</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>