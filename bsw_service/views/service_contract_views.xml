<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_service_contract_list" model="ir.ui.view">
            <field name="name">service.contract.list</field>
            <field name="model">service.contract</field>
            <field name="arch" type="xml">
                <list string="Contrats">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="contract_type"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                </list>
            </field>
        </record>

        <record id="view_service_contract_form" model="ir.ui.view">
            <field name="name">service.contract.form</field>
            <field name="model">service.contract</field>
            <field name="arch" type="xml">
                <form string="Contrat">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="contract_type"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active"/>
                        </group>
                        <group string="Produits couverts">
                            <field name="product_ids" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_service_contract" model="ir.actions.act_window">
            <field name="name">Contrats</field>
            <field name="res_model">service.contract</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>