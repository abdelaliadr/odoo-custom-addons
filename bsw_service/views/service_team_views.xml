<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_service_team_list" model="ir.ui.view">
            <field name="name">service.team.list</field>
            <field name="model">service.team</field>
            <field name="arch" type="xml">
                <list string="Équipes">
                    <field name="name"/>
                    <field name="member_count"/>
                </list>
            </field>
        </record>

        <record id="view_service_team_form" model="ir.ui.view">
            <field name="name">service.team.form</field>
            <field name="model">service.team</field>
            <field name="arch" type="xml">
                <form string="Équipe">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <notebook>
                            <page string="Techniciens">
                                <field name="member_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="phone"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_service_team" model="ir.actions.act_window">
            <field name="name">Équipes</field>
            <field name="res_model">service.team</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>