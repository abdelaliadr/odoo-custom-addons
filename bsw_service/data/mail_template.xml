<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_intervention_done" model="mail.template">
            <field name="name">Intervention : clôture</field>
            <field name="model_id" ref="model_service_intervention"/>
            <field name="subject">Votre intervention {{ object.name }} est terminée</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Bonjour {{ object.partner_id.name }},</p>
                    <p>
                        Nous vous confirmons que l'intervention
                        <strong>{{ object.name }}</strong> a été réalisée avec succès.
                    </p>
                    <p>
                        Technicien : {{ object.technician_id.name or 'N/A' }}<br/>
                        Date de fin : {{ object.date_end or 'N/A' }}
                    </p>
                    <p>Merci de votre confiance.</p>
                </div>
            </field>
        </record>

    </data>
</odoo>